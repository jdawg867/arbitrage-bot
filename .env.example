ALCHEMY_API_KEY=""
PRIVATE_KEY=""

# Optional — full WebSocket RPC URL. Overrides the Alchemy default, so you can
# use any provider (a fresh Alchemy app, or a keyless public endpoint) — handy
# when a monthly CU quota is exhausted. Must be a wss:// endpoint (the bot needs
# subscriptions). Examples:
#   RPC_WSS_URL="wss://arb-mainnet.g.alchemy.com/v2/OTHER_KEY"
#   RPC_WSS_URL="wss://arbitrum-one-rpc.publicnode.com"
RPC_WSS_URL=""

# Optional — stats dashboard
PORT="5000"
DASHBOARD_USER=""
DASHBOARD_PASS=""
